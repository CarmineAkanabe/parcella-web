# Parcella Web — Environment Configuration Template
# Copy this file to `.env` for local development or configure these variables
# in your deployment platform (e.g., Vercel Environment Variables).

# Backend REST API v1 base URL
# Local example: http://localhost:8080/api/v1
# Production example: https://api.your-domain.com/api/v1
VITE_API_BASE_URL=https://api.example.com/api/v1

# OpenStreetMap Nominatim Geocoding Endpoint (or your self-hosted/proxied instance)
VITE_NOMINATIM_URL=https://nominatim.openstreetmap.org

# Raster Map Tile URL Template ({s}, {z}, {x}, {y} placeholders)
VITE_OSM_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
